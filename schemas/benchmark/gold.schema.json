{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem Contract Benchmark reference review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "label_status",
    "as_of_date",
    "review",
    "adjudication"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "case_id": {"type": "string", "pattern": "^ORCB-[A-F0-9]{12}$"},
    "label_status": {"enum": ["provisional", "silver", "gold", "disputed"]},
    "as_of_date": {"type": "string", "format": "date"},
    "review": {
      "description": "Validated separately against prediction.schema.json.",
      "type": "object"
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewers", "agreement", "disagreements", "notes"],
      "properties": {
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "agreement": {"enum": ["single-review", "full", "partial", "none"]},
        "disagreements": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    }
  }
}
