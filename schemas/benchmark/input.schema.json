{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open-research screening benchmark input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "candidate_id",
    "domain",
    "canonical_title",
    "canonical_statement",
    "aliases",
    "source_open_questions",
    "evidence_mode",
    "task"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^ORSB-[A-F0-9]{12}$"},
    "candidate_id": {"type": "string", "pattern": "^CAN-[A-F0-9]{12}$"},
    "domain": {"type": "string", "minLength": 1},
    "canonical_title": {"type": "string", "minLength": 1},
    "canonical_statement": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "source_open_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "content",
          "id",
          "global_id",
          "paper_id",
          "paper_title",
          "paper_doi",
          "source_path"
        ],
        "properties": {
          "content": {"type": ["string", "null"]},
          "id": {"type": ["string", "null"]},
          "global_id": {"type": ["string", "null"]},
          "paper_id": {"type": ["string", "null"]},
          "paper_title": {"type": "string"},
          "paper_doi": {"type": "string"},
          "source_path": {"const": "data.papers[].open_questions"}
        }
      }
    },
    "evidence_mode": {"enum": ["live-retrieval", "frozen-evidence"]},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judge_importance", "judge_review_scope", "judge_ci_buildability"],
      "properties": {
        "judge_importance": {"const": true},
        "judge_review_scope": {"const": true},
        "judge_ci_buildability": {"const": true}
      }
    }
  }
}
