{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem Contract Benchmark input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "domain",
    "topic",
    "candidate_contract",
    "frozen_evidence",
    "evidence_mode"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "case_id": {"type": "string", "pattern": "^ORCB-[A-F0-9]{12}$"},
    "domain": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "candidate_contract": {
      "description": "A fixed candidate validated separately against schemas/problem-contract.schema.json.",
      "type": "object"
    },
    "frozen_evidence": {
      "description": "The complete offline evidence dossier available to the evaluated Reviewer.",
      "type": "object",
      "minProperties": 1
    },
    "evidence_mode": {"type": "string", "const": "frozen-evidence"}
  }
}
