{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open-research screening benchmark input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "candidate_id",
    "domain",
    "canonical_title",
    "canonical_statement",
    "aliases",
    "source_support",
    "source_open_questions",
    "frozen_evidence",
    "evidence_mode",
    "task"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 9},
    "case_id": {"type": "string", "pattern": "^ORSB-[A-F0-9]{12}$"},
    "candidate_id": {"type": "string", "pattern": "^CAN-[A-F0-9]{12}$"},
    "domain": {"type": "string", "minLength": 1},
    "canonical_title": {"type": "string", "minLength": 1},
    "canonical_statement": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "source_support": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_key", "exact_excerpt"],
        "properties": {
          "source_key": {"type": "string", "minLength": 1},
          "exact_excerpt": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_open_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "content",
          "id",
          "global_id",
          "paper_id",
          "paper_title",
          "paper_doi",
          "source_path"
        ],
        "properties": {
          "content": {"type": ["string", "null"]},
          "id": {"type": ["string", "null"]},
          "global_id": {"type": ["string", "null"]},
          "paper_id": {"type": ["string", "null"]},
          "paper_title": {"type": "string"},
          "paper_doi": {"type": "string"},
          "source_path": {
            "type": "string",
            "const": "data.papers[].open_questions"
          }
        }
      }
    },
    "frozen_evidence": {
      "description": "Self-contained evidence available to the offline evaluated agent. It may include source LKM records and neutral later-literature summaries, but never benchmark labels.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "kind",
          "title",
          "identifier",
          "content_level",
          "content"
        ],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "source-open-question",
              "later-literature",
              "current-baseline"
            ]
          },
          "title": {"type": "string"},
          "identifier": {"type": "string"},
          "content_level": {
            "enum": [
              "lkm_open_question",
              "metadata",
              "abstract",
              "compressed_claim",
              "reasoning_chain",
              "partial_full_text",
              "full_text",
              "curated_summary"
            ]
          },
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_mode": {"enum": ["live-retrieval", "frozen-evidence"]},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judge_importance",
        "describe_expected_result",
        "judge_verification_difficulty",
        "judge_ci_buildability",
        "verification_difficulty_rubric"
      ],
      "properties": {
        "judge_importance": {"type": "boolean", "const": true},
        "describe_expected_result": {"type": "boolean", "const": true},
        "judge_verification_difficulty": {"type": "boolean", "const": true},
        "judge_ci_buildability": {"type": "boolean", "const": true},
        "verification_difficulty_rubric": {"type": "string", "minLength": 1}
      }
    }
  }
}
