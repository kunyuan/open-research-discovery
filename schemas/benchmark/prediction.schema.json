{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open-research screening benchmark prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "importance", "solution_review", "ci"],
  "properties": {
    "schema_version": {"type": "integer", "const": 7},
    "case_id": {"type": "string", "pattern": "^ORSB-[A-F0-9]{12}$"},
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence", "rationale"],
      "properties": {
        "label": {"enum": ["high", "medium", "low", "uncertain"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string"}
      }
    },
    "solution_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "confidence", "expected_result", "rationale"],
      "properties": {
        "scope": {
          "enum": [
            "result-only",
            "result-and-derivation",
            "expert-intensive",
            "uncertain"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_result": {"type": "string", "minLength": 1},
        "rationale": {
          "description": "Explain why the expected result genuinely answers the source question, any scope limitations, and why review does or does not need anything outside that result.",
          "type": "string"
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildability",
        "confidence",
        "verification_contract",
        "pseudocode",
        "estimated_runtime",
        "timeout_minutes",
        "rationale"
      ],
      "properties": {
        "buildability": {
          "enum": [
            "machine",
            "bounded-llm",
            "hybrid",
            "not-buildable",
            "uncertain"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "verification_contract": {"type": "string"},
        "pseudocode": {"type": "array", "items": {"type": "string"}},
        "estimated_runtime": {"type": "string"},
        "timeout_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
        "rationale": {"type": "string"}
      }
    }
  }
}
