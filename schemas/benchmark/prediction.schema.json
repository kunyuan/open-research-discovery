{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open-research screening benchmark prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "importance",
    "review",
    "ci"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "case_id": {"type": "string", "pattern": "^ORSB-[A-F0-9]{12}$"},
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence", "rationale", "consequences_of_progress"],
      "properties": {
        "label": {"enum": ["high", "medium", "low", "uncertain"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string"},
        "consequences_of_progress": {"type": "string"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "confidence",
        "solution_route",
        "route_scientific_effect",
        "route_sufficiency",
        "route_scope_limitations",
        "acceptance_obligations",
        "artifact_type",
        "uses_proof_assistant",
        "expected_artifact",
        "acceptance_boundary",
        "rationale"
      ],
      "properties": {
        "scope": {
          "description": "result-only means the frozen problem, source-grounded final deliverable, trusted verifiers, and frozen reference data suffice; hiding the solver's search and reasoning process and every undeclared auxiliary explanation cannot change the verdict. Formal proof code counts only when the source explicitly requests formalization or a machine-checkable proof or certificate. Verification mode is a separate axis.",
          "enum": [
            "result-only",
            "result-and-derivation",
            "expert-intensive",
            "uncertain"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "solution_route": {"type": "string", "minLength": 1},
        "route_scientific_effect": {
          "enum": [
            "resolves-core",
            "refutes-core",
            "proves-core",
            "sharpens-bound",
            "constructs-requested-object",
            "meaningful-partial-progress",
            "benchmark-only",
            "uncertain"
          ]
        },
        "route_sufficiency": {"type": "boolean"},
        "route_scope_limitations": {"type": "string"},
        "acceptance_obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_key",
              "exact_excerpt",
              "kind",
              "description",
              "required"
            ],
            "properties": {
              "source_key": {"type": "string", "minLength": 1},
              "exact_excerpt": {"type": "string", "minLength": 1},
              "kind": {
                "enum": [
                  "direct-artifact",
                  "source-requested-formal-proof",
                  "derivation",
                  "expert-judgment"
                ]
              },
              "description": {"type": "string", "minLength": 1},
              "required": {"const": true}
            }
          }
        },
        "artifact_type": {
          "enum": [
            "counterexample",
            "construction",
            "algorithm",
            "certificate",
            "formal-proof",
            "theorem-boundary",
            "dataset",
            "experimental-result",
            "simulation-result",
            "model",
            "protocol",
            "other"
          ]
        },
        "uses_proof_assistant": {"type": "boolean"},
        "expected_artifact": {"type": "string"},
        "acceptance_boundary": {"type": "string"},
        "rationale": {"type": "string"}
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildability",
        "confidence",
        "verification_contract",
        "pseudocode",
        "estimated_runtime",
        "timeout_minutes",
        "rationale"
      ],
      "properties": {
        "buildability": {
          "enum": [
            "machine",
            "bounded-llm",
            "hybrid",
            "not-buildable",
            "uncertain"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "verification_contract": {"type": "string"},
        "pseudocode": {"type": "array", "items": {"type": "string"}},
        "estimated_runtime": {"type": "string"},
        "timeout_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
        "rationale": {"type": "string"}
      }
    }
  }
}
