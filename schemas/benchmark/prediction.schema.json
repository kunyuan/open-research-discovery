{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem Contract Benchmark review prediction",
  "$defs": {
    "field_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "rationale", "evidence_refs"],
      "properties": {
        "verdict": {"enum": ["pass", "minor_issue", "major_issue"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "must_fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "issue"],
      "properties": {
        "field": {
          "enum": [
            "schema_version",
            "problem_id",
            "parent_problem_id",
            "subproblem_ids",
            "title",
            "abstract",
            "background",
            "references",
            "previous_progress",
            "problem_statement",
            "scientific_significance",
            "solution_difficulty",
            "verification_contract",
            "verification_difficulty",
            "cross_field_consistency",
            "evidence_fidelity"
          ]
        },
        "issue": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "problem_id",
    "field_reviews",
    "overall_verdict",
    "overall_rationale",
    "must_fix",
    "rewrite_prompt"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "case_id": {"type": "string", "pattern": "^ORCB-[A-F0-9]{12}$"},
    "problem_id": {"type": "string", "minLength": 1},
    "field_reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "problem_id",
        "parent_problem_id",
        "subproblem_ids",
        "title",
        "abstract",
        "background",
        "references",
        "previous_progress",
        "problem_statement",
        "scientific_significance",
        "solution_difficulty",
        "verification_contract",
        "verification_difficulty",
        "cross_field_consistency",
        "evidence_fidelity"
      ],
      "properties": {
        "schema_version": {"$ref": "#/$defs/field_review"},
        "problem_id": {"$ref": "#/$defs/field_review"},
        "parent_problem_id": {"$ref": "#/$defs/field_review"},
        "subproblem_ids": {"$ref": "#/$defs/field_review"},
        "title": {"$ref": "#/$defs/field_review"},
        "abstract": {"$ref": "#/$defs/field_review"},
        "background": {"$ref": "#/$defs/field_review"},
        "references": {"$ref": "#/$defs/field_review"},
        "previous_progress": {"$ref": "#/$defs/field_review"},
        "problem_statement": {"$ref": "#/$defs/field_review"},
        "scientific_significance": {"$ref": "#/$defs/field_review"},
        "solution_difficulty": {"$ref": "#/$defs/field_review"},
        "verification_contract": {"$ref": "#/$defs/field_review"},
        "verification_difficulty": {"$ref": "#/$defs/field_review"},
        "cross_field_consistency": {"$ref": "#/$defs/field_review"},
        "evidence_fidelity": {"$ref": "#/$defs/field_review"}
      }
    },
    "overall_verdict": {"enum": ["accept", "rewrite", "reject"]},
    "overall_rationale": {"type": "string", "minLength": 1},
    "must_fix": {"type": "array", "items": {"$ref": "#/$defs/must_fix"}},
    "rewrite_prompt": {"type": "string"}
  }
}
