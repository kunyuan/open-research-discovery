{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open-research screening benchmark prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "importance",
    "review",
    "ci"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^ORSB-[A-F0-9]{12}$"},
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence", "rationale", "consequences_of_progress"],
      "properties": {
        "label": {"enum": ["high", "medium", "low", "uncertain"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string"},
        "consequences_of_progress": {"type": "string"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "confidence",
        "expected_artifact",
        "acceptance_boundary",
        "rationale"
      ],
      "properties": {
        "scope": {
          "enum": [
            "result-only",
            "result-and-derivation",
            "expert-intensive",
            "uncertain"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_artifact": {"type": "string"},
        "acceptance_boundary": {"type": "string"},
        "rationale": {"type": "string"}
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildability",
        "confidence",
        "verification_contract",
        "pseudocode",
        "estimated_runtime",
        "timeout_minutes",
        "rationale"
      ],
      "properties": {
        "buildability": {
          "enum": [
            "machine",
            "bounded-llm",
            "hybrid",
            "not-buildable",
            "uncertain"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "verification_contract": {"type": "string"},
        "pseudocode": {"type": "array", "items": {"type": "string"}},
        "estimated_runtime": {"type": "string"},
        "timeout_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
        "rationale": {"type": "string"}
      }
    }
  }
}
