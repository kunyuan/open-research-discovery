{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open research discovery campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "domains", "limits", "agents", "outputs"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "query", "seed_papers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "query": {"type": "string", "minLength": 1},
          "seed_papers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["paper_id", "doi", "title"],
              "properties": {
                "paper_id": {"type": "string"},
                "doi": {"type": "string"},
                "title": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "papers_per_domain",
        "questions_per_domain",
        "lkm_timeout_seconds"
      ],
      "properties": {
        "papers_per_domain": {"type": "integer", "minimum": 1, "maximum": 100},
        "questions_per_domain": {"type": "integer", "minimum": 1, "maximum": 1000},
        "lkm_timeout_seconds": {"type": "number", "minimum": 1, "maximum": 600}
      }
    },
    "strategies": {
      "description": "Hot-pluggable candidate-seed producers. When omitted, the legacy LKM explicit-open-question strategy is used.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "search_groups": {"type": "integer", "minimum": 2, "maximum": 8},
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["lkm", "web"]}
          },
          "max_candidates_per_domain": {"type": "integer", "minimum": 1, "maximum": 100},
          "settings": {
            "description": "Strategy-specific extension settings for registry plugins.",
            "type": "object"
          }
        }
      }
    },
    "selection": {
      "description": "Optional quality-diversity portfolio cap. If omitted, all eligible candidates follow the legacy path.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target_problem_count", "shortlist_multiplier"],
      "properties": {
        "target_problem_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "shortlist_multiplier": {"type": "integer", "minimum": 1, "maximum": 2}
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "codex_executable", "sandbox", "timeout_seconds"],
      "properties": {
        "model": {"type": "string"},
        "codex_executable": {"type": "string", "minLength": 1},
        "sandbox": {"enum": ["read-only", "workspace-write"]},
        "networked_sandbox": {"enum": ["read-only", "workspace-write"]},
        "network_access": {"type": "boolean"},
        "workers": {"type": "integer", "minimum": 1, "maximum": 16},
        "networked_workers": {
          "description": "Maximum concurrent networked agents (Discovery, strategy search, Research) across all parallel regions; defaults to workers when omitted.",
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "retries": {
          "description": "Retries after a failed agent invocation with exponential backoff; contract failures are never retried. Defaults to 1.",
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "retry_backoff_seconds": {
          "description": "Base seconds for the retry backoff; retry attempt n sleeps backoff * 2^(n-1). Defaults to 5.",
          "type": "number",
          "minimum": 0
        },
        "timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 14400}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs_root", "problem_root", "pool_root"],
      "properties": {
        "runs_root": {"type": "string", "minLength": 1},
        "problem_root": {"type": "string", "minLength": 1},
        "pool_root": {"type": "string"}
      }
    }
  }
}
