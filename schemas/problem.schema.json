{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kunyuan/open-research-discovery/schemas/problem.schema.json",
  "title": "Agent-ready open research problem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "domain",
    "status",
    "question",
    "source_open_questions",
    "resolution_audit",
    "importance",
    "research_triage",
    "discovery_contract",
    "solution_review_contract",
    "ci_contract",
    "compute"
  ],
  "properties": {
    "schema_version": {
      "enum": [2, 3]
    },
    "id": {
      "type": "string",
      "pattern": "^(ORP|OMP)-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string"
    },
    "topic_id": {
      "type": "string"
    },
    "topic_title": {
      "type": "string"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slug", "topic_id"],
      "properties": {
        "kind": {"const": "topic"},
        "slug": {"type": "string", "minLength": 1},
        "topic_id": {"type": "string", "minLength": 1}
      }
    },
    "status": {
      "enum": [
        "draft",
        "resolution-audited",
        "ready",
        "active",
        "progress",
        "solved",
        "resolved-externally",
        "refuted-externally",
        "duplicate",
        "uncertain"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_statement",
        "definitions",
        "scope",
        "aliases"
      ],
      "properties": {
        "canonical_statement": {
          "type": "string"
        },
        "definitions": {
          "description": "Ordered prose blocks for an academic-style explanation of the problem: scientific background, origin in prior work, specialist terminology, and the discipline-appropriate details needed to understand the unresolved target. Equations, experimental conditions, datasets, metrics, parameter ranges, or conventions should appear only when relevant to the particular field and problem.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "paper_id",
          "local_id"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "paper_id": {
            "type": "string"
          },
          "local_id": {
            "type": "string"
          },
          "source_key": {
            "type": "string"
          },
          "exact_text": {
            "type": "string"
          },
          "publication_date": {
            "type": "string"
          },
          "paper_title": {
            "type": "string"
          },
          "paper_doi": {
            "type": "string"
          },
          "source_path": {
            "const": "data.papers[].open_questions"
          }
        }
      }
    },
    "sources": {
      "description": "Generic source records. They may be dedicated LKM open questions or context-grounded leads derived from LKM, web, papers, books, datasets, or user references.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_key",
          "kind",
          "title",
          "identifier",
          "url",
          "locator",
          "exact_excerpt",
          "surrounding_context",
          "source_intent",
          "relationship",
          "explicit_open_question"
        ],
        "properties": {
          "source_key": {"type": "string", "minLength": 1},
          "kind": {"enum": ["lkm_open_question", "lkm", "web", "paper", "book", "dataset", "user_reference"]},
          "title": {"type": "string", "minLength": 1},
          "identifier": {"type": "string"},
          "url": {"type": "string"},
          "locator": {"type": "string"},
          "exact_excerpt": {"type": "string", "minLength": 1},
          "surrounding_context": {"type": "string", "minLength": 1},
          "source_intent": {"type": "string", "minLength": 1},
          "relationship": {"type": "string", "minLength": 1},
          "explicit_open_question": {"type": "boolean"},
          "author_attribution_verified": {"type": "boolean"}
        }
      }
    },
    "resolution_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_at",
        "checked_through",
        "status",
        "surviving_open_core",
        "evidence",
        "progress_assessment"
      ],
      "properties": {
        "checked_at": {
          "type": "string"
        },
        "checked_through": {
          "type": "string"
        },
        "status": {
          "enum": [
            "still_open",
            "partially_resolved",
            "resolved",
            "refuted",
            "uncertain"
          ]
        },
        "coverage": {
          "enum": [
            "lkm_only",
            "systematic_literature"
          ]
        },
        "surviving_open_core": {
          "type": "string"
        },
        "conclusion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "confidence",
            "rationale",
            "literature_treatment"
          ],
          "properties": {
            "label": {
              "enum": [
                "confirmed_open",
                "likely_open",
                "resolved",
                "refuted",
                "needs_reformulation"
              ]
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "rationale": {
              "type": "string"
            },
            "literature_treatment": {
              "type": "string"
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "progress_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major_progress_found",
            "effect",
            "surviving_core_reassessed",
            "importance_reassessed",
            "solution_review_reassessed",
            "decision",
            "derived_problem_ids"
          ],
          "properties": {
            "major_progress_found": {
              "type": "boolean"
            },
            "effect": {
              "enum": [
                "none",
                "narrows",
                "resolves",
                "refutes",
                "reframes",
                "uncertain"
              ]
            },
            "surviving_core_reassessed": {
              "type": "boolean"
            },
            "importance_reassessed": {
              "type": "boolean"
            },
            "solution_review_reassessed": {
              "type": "boolean"
            },
            "decision": {
              "enum": [
                "continue",
                "rewrite-core",
                "new-derived-problem",
                "stop",
                "unassessed"
              ]
            },
            "derived_problem_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(ORP|OMP)-[0-9]{4,}$"
              }
            }
          }
        }
      }
    },
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motivation",
        "consequences_of_progress",
        "current_best_result"
      ],
      "properties": {
        "scientific_significance_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "scientific_significance_rationale": {
          "type": "string"
        },
        "motivation": {
          "type": "string"
        },
        "consequences_of_progress": {
          "type": "string"
        },
        "current_best_result": {
          "type": "string"
        }
      }
    },
    "research_triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importance_level",
        "audit_priority",
        "post_audit_priority",
        "route",
        "rationale"
      ],
      "properties": {
        "reviewed_at": {
          "type": "string"
        },
        "importance_level": {
          "enum": [
            "high",
            "medium",
            "low",
            "unassessed"
          ]
        },
        "audit_priority": {
          "enum": [
            "high",
            "medium",
            "low",
            "hold",
            "unassessed"
          ]
        },
        "post_audit_priority": {
          "enum": [
            "high",
            "medium",
            "low",
            "hold",
            "closed",
            "unassessed"
          ]
        },
        "route": {
          "enum": [
            "candidate-result",
            "manual-review",
            "status-audit",
            "derived-audit",
            "reformulation",
            "closed",
            "unassessed"
          ]
        },
        "max_verification_difficulty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "verification_threshold_applied": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "discovery_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_result"],
      "properties": {
        "expected_result": {
          "type": "string"
        },
        "answer_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "solution_review_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_difficulty",
        "rationale",
        "checklist",
        "estimated_review_time",
        "acceptance_boundary"
      ],
      "properties": {
        "verification_difficulty": {
          "description": "Residual verification burden on an independent reviewer from 0 to 10, after every mechanically delegable check has been delegated. Zero means all load-bearing claims are discharged by mechanical checks, replay, or certificates with trivial specification fidelity; it does not require CI.",
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "verification_clarity": {
          "enum": ["clear", "needs_decomposition", "unverifiable"]
        },
        "verification_standard": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        },
        "checklist": {
          "type": "string",
          "minLength": 1
        },
        "estimated_review_time": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_boundary": {
          "type": "string"
        }
      }
    },
    "ci_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "workflow",
        "driver",
        "pseudocode",
        "runner",
        "estimated_runtime",
        "timeout_minutes"
      ],
      "properties": {
        "status": {
          "enum": [
            "implemented",
            "partial",
            "pseudocode",
            "solution-reviewer-only",
            "blocked"
          ]
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "pseudocode": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "estimated_runtime": {
          "type": "string",
          "minLength": 1
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        }
      }
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_scale",
        "cpu",
        "gpu",
        "notes"
      ],
      "properties": {
        "expected_scale": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "gpu": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
