{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kunyuan/open-research-discovery/schemas/problem.schema.json",
  "title": "Agent-ready open research problem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "domain",
    "status",
    "question",
    "source_open_questions",
    "resolution_audit",
    "importance",
    "research_triage",
    "discovery_contract",
    "solution_review_contract",
    "ci_contract"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "ready"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "resolution_audit": {
            "properties": {
              "evidence": {
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "required": ["title", "date", "content_level", "relation", "supports", "direct_support"],
                  "properties": {
                    "title": {"type": "string", "minLength": 1},
                    "date": {"type": "string", "minLength": 1},
                    "content_level": {"enum": ["abstract", "compressed_claim", "reasoning_chain", "partial_full_text", "full_text"]},
                    "relation": {"enum": ["closure", "refutation", "special_case", "improved_bound", "reformulation", "continuing_open"]},
                    "supports": {"type": "string", "minLength": 1},
                    "direct_support": {"const": true}
                  },
                  "anyOf": [
                    {"required": ["identifier"], "properties": {"identifier": {"type": "string", "minLength": 1}}},
                    {"required": ["url"], "properties": {"url": {"type": "string", "minLength": 1}}}
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "id": {
      "type": "string",
      "pattern": "^ORP-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string"
    },
    "topic_id": {
      "type": "string"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slug"],
      "properties": {
        "kind": {
          "description": "solution is the current one-problem repository layout; topic is retained for legacy compiled records.",
          "enum": ["solution", "topic"]
        },
        "slug": {"type": "string", "minLength": 1}
      }
    },
    "status": {
      "enum": [
        "resolution-audited",
        "ready",
        "resolved-externally",
        "refuted-externally",
        "uncertain"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_statement",
        "definitions",
        "scope",
        "aliases"
      ],
      "properties": {
        "canonical_statement": {
          "description": "Source-faithful research question at its natural level of generality. It must not be narrowed merely to simplify verification.",
          "type": "string"
        },
        "definitions": {
          "description": "Ordered prose blocks for an academic-style explanation of the problem: scientific background, origin in prior work, specialist terminology, and the discipline-appropriate details needed to understand the unresolved target. Equations, experimental conditions, datasets, metrics, parameter ranges, or conventions should appear only when relevant to the particular field and problem.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "description": "Only intrinsic assumptions from the authoritative formulation or an evidence-supported surviving open core. Artificial finite-size, parameter, method, or answer-form restrictions are forbidden.",
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "named_problem": {"type": "boolean"},
        "formulation_alignment": {
          "enum": ["exact", "equivalent", "derived", "not_applicable"]
        },
        "authoritative_formulation": {
          "description": "Audited primary or standard formulation for a named problem, linked to direct research evidence; null otherwise.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["citation", "url", "exact_excerpt", "evidence_identifier"],
          "properties": {
            "citation": {"type": "string", "minLength": 1},
            "url": {"type": "string"},
            "exact_excerpt": {"type": "string", "minLength": 1},
            "evidence_identifier": {"type": "string", "minLength": 1}
          }
        },
        "lineage": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["parent_candidate_id", "relation_to_parent"],
          "properties": {
            "parent_candidate_id": {"type": "string", "minLength": 1},
            "relation_to_parent": {"enum": ["component", "restricted_derived"]}
          }
        }
      }
    },
    "source_open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "paper_id",
          "local_id"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "paper_id": {
            "type": "string"
          },
          "local_id": {
            "type": "string"
          },
          "publication_date": {
            "type": "string"
          },
          "paper_title": {
            "type": "string"
          },
          "paper_doi": {
            "type": "string"
          },
          "source_path": {
            "const": "data.papers[].open_questions"
          }
        }
      }
    },
    "sources": {
      "description": "Generic source records. They may be dedicated LKM open questions or context-grounded leads derived from LKM, web, papers, books, datasets, or user references.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_key",
          "kind",
          "title",
          "identifier",
          "url",
          "locator",
          "exact_excerpt",
          "surrounding_context",
          "source_intent",
          "relationship"
        ],
        "properties": {
          "source_key": {"type": "string", "minLength": 1},
          "kind": {"enum": ["lkm_open_question", "lkm", "web", "paper", "book", "dataset", "user_reference"]},
          "title": {"type": "string", "minLength": 1},
          "identifier": {"type": "string"},
          "url": {"type": "string"},
          "locator": {"type": "string"},
          "date": {"type": "string"},
          "exact_excerpt": {"type": "string", "minLength": 1},
          "surrounding_context": {"type": "string", "minLength": 1},
          "source_intent": {"type": "string", "minLength": 1},
          "relationship": {"type": "string", "minLength": 1},
          "author_attribution_verified": {"type": "boolean"}
        }
      }
    },
    "resolution_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_through",
        "status",
        "surviving_open_core",
        "evidence",
        "progress_assessment"
      ],
      "properties": {
        "checked_through": {
          "type": "string"
        },
        "status": {
          "enum": [
            "still_open",
            "partially_resolved",
            "resolved",
            "refuted",
            "uncertain"
          ]
        },
        "surviving_open_core": {
          "type": "string"
        },
        "conclusion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "confidence"
          ],
          "properties": {
            "label": {
              "enum": [
                "confirmed_open",
                "likely_open",
                "resolved",
                "refuted",
                "needs_reformulation"
              ]
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "progress_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major_progress_found",
            "effect",
            "reassessed",
            "decision"
          ],
          "properties": {
            "major_progress_found": {
              "type": "boolean"
            },
            "effect": {
              "enum": [
                "none",
                "narrows",
                "resolves",
                "refutes",
                "reframes",
                "uncertain"
              ]
            },
            "reassessed": {
              "description": "Whether the surviving core, importance, and solution review were reassessed after major later progress.",
              "type": "boolean"
            },
            "decision": {
              "enum": [
                "continue",
                "rewrite-core",
                "new-derived-problem",
                "stop",
                "unassessed"
              ]
            }
          }
        }
      }
    },
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motivation",
        "consequences_of_progress",
        "current_best_result"
      ],
      "properties": {
        "motivation": {
          "type": "string"
        },
        "consequences_of_progress": {
          "type": "string"
        },
        "current_best_result": {
          "type": "string"
        }
      }
    },
    "research_triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importance_level",
        "post_audit_priority",
        "route",
        "scientific_significance_score",
        "scientific_significance_rationale",
        "verification_threshold_applied"
      ],
      "properties": {
        "importance_level": {
          "enum": [
            "high",
            "medium",
            "low",
            "unassessed"
          ]
        },
        "scientific_significance_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "scientific_significance_rationale": {
          "type": "string"
        },
        "post_audit_priority": {
          "enum": [
            "high",
            "medium",
            "low",
            "hold",
            "closed",
            "unassessed"
          ]
        },
        "route": {
          "enum": [
            "candidate-result",
            "manual-review",
            "status-audit",
            "closed",
            "unassessed"
          ]
        },
        "verification_threshold_applied": {
          "type": "boolean"
        }
      }
    },
    "discovery_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_result"],
      "properties": {
        "expected_result": {
          "type": "string"
        },
        "answer_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "solution_review_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_difficulty",
        "rationale",
        "checklist",
        "estimated_review_time",
        "acceptance_boundary"
      ],
      "properties": {
        "verification_difficulty": {
          "description": "Residual verification burden on an independent reviewer from 0 to 10, after every mechanically delegable check has been delegated. Zero means all load-bearing claims are discharged by mechanical checks, replay, or certificates with trivial specification fidelity; it does not require CI.",
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "verification_clarity": {
          "enum": ["clear", "needs_decomposition", "unverifiable"]
        },
        "verification_standard": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        },
        "checklist": {
          "type": "string",
          "minLength": 1
        },
        "estimated_review_time": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_boundary": {
          "type": "string"
        }
      }
    },
    "ci_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "pseudocode",
        "runner",
        "estimated_runtime",
        "timeout_minutes"
      ],
      "properties": {
        "status": {
          "enum": [
            "implemented",
            "partial",
            "pseudocode",
            "solution-reviewer-only",
            "blocked"
          ]
        },
        "pseudocode": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "estimated_runtime": {
          "type": "string",
          "minLength": 1
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        }
      }
    }
  }
}
