{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem-quality benchmark input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "problem",
    "readme_markdown",
    "contract_valid",
    "validation_errors",
    "frozen_evidence",
    "evidence_mode",
    "provenance",
    "task"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "description": "The Problem Contract under review. It is the content authority; the README is only a deterministic projection. Invalid contracts are still recorded here and flagged via contract_valid.",
      "type": "object"
    },
    "readme_markdown": {
      "description": "Contents of the problem repository README.md when it could be located; empty string otherwise.",
      "type": "string"
    },
    "contract_valid": {
      "description": "Whether problem passed problem.schema validation at build time.",
      "type": "boolean"
    },
    "validation_errors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "frozen_evidence": {
      "description": "Citation metadata frozen at build time for every resolvable identifier appearing in references. The evaluated agent must cross-check citations against these records only; it must not retrieve.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "kind",
          "fetched_at",
          "status",
          "metadata",
          "detail"
        ],
        "properties": {
          "identifier": {"type": "string", "minLength": 1},
          "kind": {"enum": ["arxiv", "doi", "url", "other"]},
          "fetched_at": {"type": "string"},
          "status": {"enum": ["found", "not_found", "error", "skipped"]},
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "authors", "venue", "year", "doi", "url"],
            "properties": {
              "title": {"type": "string"},
              "authors": {"type": "array", "items": {"type": "string"}},
              "venue": {"type": "string"},
              "year": {"type": ["integer", "null"]},
              "doi": {"type": "string"},
              "url": {"type": "string"}
            }
          },
          "detail": {"type": "string"}
        }
      }
    },
    "evidence_mode": {"enum": ["live-retrieval", "frozen-evidence"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "run_dir", "candidate_id", "candidate_dir", "pool_root"],
      "properties": {
        "origin": {"enum": ["run_dir", "pool", "manifest"]},
        "run_dir": {"type": "string"},
        "candidate_id": {"type": "string"},
        "candidate_dir": {"type": "string"},
        "pool_root": {"type": "string"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judge_quality_dimensions", "rubric"],
      "properties": {
        "judge_quality_dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "citation_accuracy",
              "scientific_soundness",
              "scope_fidelity",
              "verification_executability",
              "evidence_relevance"
            ]
          }
        },
        "rubric": {"type": "string", "minLength": 1}
      }
    }
  }
}
