{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Agent assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "canonical_title",
    "canonical_statement",
    "definitions",
    "scope",
    "aliases",
    "resolution_status",
    "coverage",
    "resolution_conclusion",
    "resolution_confidence",
    "literature_treatment",
    "status_rationale",
    "checked_through",
    "major_progress_found",
    "major_progress_effect",
    "major_progress_summary",
    "surviving_open_core",
    "post_progress_decision",
    "importance_level",
    "importance_motivation",
    "consequences_of_progress",
    "current_best_result",
    "expected_result",
    "verification_difficulty",
    "verification_difficulty_rationale",
    "solution_review_checklist",
    "estimated_solution_review_time",
    "acceptance_boundary",
    "ci_status",
    "ci_pseudocode",
    "ci_runner",
    "ci_estimated_runtime",
    "ci_timeout_minutes",
    "compute",
    "evidence"
  ],
  "properties": {
    "candidate_id": {"type": "string"},
    "canonical_title": {"type": "string", "minLength": 1},
    "canonical_statement": {"type": "string", "minLength": 1},
    "definitions": {
      "description": "Ordered prose blocks for the academic-style problem explanation: introduce the scientific setting, explain specialist terms and acronyms, summarize the prior result or limitation that gives rise to the question, and state any discipline-specific information needed to understand the unresolved target. Use equations, experimental conditions, datasets, metrics, parameter ranges, or conventions only when relevant; an unexplained acronym or external equation reference alone is insufficient.",
      "type": "array",
      "items": {"type": "string"}
    },
    "scope": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "resolution_status": {
      "enum": ["still_open", "partially_resolved", "resolved", "refuted", "uncertain"]
    },
    "coverage": {"enum": ["lkm_only", "systematic_literature"]},
    "resolution_conclusion": {
      "enum": [
        "confirmed_open",
        "likely_open",
        "resolved",
        "refuted",
        "needs_reformulation"
      ]
    },
    "resolution_confidence": {"enum": ["high", "medium", "low"]},
    "literature_treatment": {"type": "string"},
    "status_rationale": {"type": "string"},
    "checked_through": {"type": "string"},
    "major_progress_found": {"type": "boolean"},
    "major_progress_effect": {
      "enum": ["none", "narrows", "resolves", "refutes", "reframes", "uncertain"]
    },
    "major_progress_summary": {"type": "string"},
    "surviving_open_core": {"type": "string"},
    "post_progress_decision": {
      "enum": ["continue", "rewrite-core", "new-derived-problem", "stop", "unassessed"]
    },
    "importance_level": {"enum": ["high", "medium", "low", "unassessed"]},
    "importance_motivation": {"type": "string"},
    "consequences_of_progress": {"type": "string"},
    "current_best_result": {"type": "string"},
    "expected_result": {"type": "string", "minLength": 1},
    "verification_difficulty": {
      "description": "Independent verification difficulty from 0 to 10. Zero means review is basically limited to the final result and does not imply mechanical verification. Scores 1-9 represent increasing dependence on substantive derivation review; 10 means correctness rests essentially on holistic review of a natural-language proof or scientific argument.",
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "verification_difficulty_rationale": {"type": "string", "minLength": 1},
    "solution_review_checklist": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "estimated_solution_review_time": {"type": "string", "minLength": 1},
    "acceptance_boundary": {"type": "string", "minLength": 1},
    "ci_status": {
      "enum": ["implemented", "partial", "pseudocode", "solution-reviewer-only", "blocked"]
    },
    "ci_pseudocode": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "ci_runner": {"type": "string", "minLength": 1},
    "ci_estimated_runtime": {"type": "string", "minLength": 1},
    "ci_timeout_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_scale", "cpu", "gpu", "notes"],
      "properties": {
        "expected_scale": {"type": "string"},
        "cpu": {"type": "string"},
        "gpu": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "title",
          "identifier",
          "url",
          "date",
          "content_level",
          "relation",
          "supports",
          "direct_support"
        ],
        "properties": {
          "source": {"enum": ["lkm", "web"]},
          "title": {"type": "string"},
          "identifier": {"type": "string"},
          "url": {"type": "string"},
          "date": {"type": "string"},
          "content_level": {
            "enum": [
              "metadata",
              "abstract",
              "compressed_claim",
              "reasoning_chain",
              "partial_full_text",
              "full_text"
            ]
          },
          "relation": {
            "enum": [
              "closure",
              "refutation",
              "special_case",
              "improved_bound",
              "reformulation",
              "continuing_open",
              "adjacent_only"
            ]
          },
          "supports": {"type": "string"},
          "direct_support": {"type": "boolean"}
        }
      }
    }
  }
}
