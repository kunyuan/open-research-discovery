{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topic semantic canonicalization output",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusters"],
  "properties": {
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "parent_theme",
          "canonical_title",
          "canonical_statement",
          "domain",
          "source_keys",
          "source_support",
          "aliases",
          "answer_types",
          "verification_plan",
          "decomposition_rationale",
          "rationale"
        ],
        "properties": {
          "topic_id": {"type": "string", "minLength": 1},
          "parent_theme": {"type": "string", "minLength": 1},
          "canonical_title": {"type": "string", "minLength": 1},
          "canonical_statement": {
            "description": "Source-faithful statement preserving the literature problem's natural generality. Famous problems must align with an authoritative formulation; restricted variants must be labeled as derived.",
            "type": "string",
            "minLength": 1
          },
          "domain": {"type": "string", "minLength": 1},
          "source_keys": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "source_support": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_key", "exact_excerpt"],
              "properties": {
                "source_key": {"type": "string", "minLength": 1},
                "exact_excerpt": {"type": "string", "minLength": 1}
              }
            }
          },
          "aliases": {"type": "array", "items": {"type": "string"}},
          "answer_types": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "verification_plan": {
            "description": "A plan for checking answers to the canonical statement; it must not narrow or redefine that statement.",
            "type": "string",
            "minLength": 1
          },
          "decomposition_rationale": {"type": "string", "minLength": 1},
          "rationale": {"type": "string"}
        }
      }
    }
  }
}
