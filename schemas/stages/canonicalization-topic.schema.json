{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topic semantic canonicalization output",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusters"],
  "properties": {
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "parent_theme",
          "canonical_title",
          "canonical_statement",
          "scope",
          "named_problem",
          "authoritative_formulation",
          "formulation_alignment",
          "domain",
          "source_keys",
          "source_support",
          "aliases",
          "answer_types",
          "verification_plan",
          "rationale"
        ],
        "properties": {
          "topic_id": {"type": "string", "minLength": 1},
          "parent_theme": {"type": "string", "minLength": 1},
          "canonical_title": {"type": "string", "minLength": 1},
          "canonical_statement": {
            "description": "Scientifically coherent statement with a transparent relation to its sources. Motivated generalizations are allowed but must be described as derived rather than attributed to the source authors. Famous problems must align with an authoritative formulation; variants must be labeled as derived.",
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "description": "Final scientific scope. It may generalize a source when the rationale gives a defensible bridge, but it must freeze the target and resolution boundary.",
            "type": "string",
            "minLength": 1
          },
          "named_problem": {"type": "boolean"},
          "authoritative_formulation": {
            "description": "Required source-grounded standard formulation for a named or famous problem; null otherwise. For a named problem, when Discovery supplied an authoritative_formulation on the lead, prefer citing it here (canonicalization has no network access).",
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["source_key", "citation", "url", "exact_excerpt"],
            "properties": {
              "source_key": {"type": "string", "minLength": 1},
              "citation": {"type": "string", "minLength": 1},
              "url": {"type": "string"},
              "exact_excerpt": {"type": "string", "minLength": 1}
            }
          },
          "formulation_alignment": {
            "enum": ["exact", "equivalent", "derived", "not_applicable"]
          },
          "domain": {"type": "string", "minLength": 1},
          "source_keys": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "source_support": {
            "description": "Per-source supporting excerpts copied from the ingested evidence records.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_key", "exact_excerpt"],
              "properties": {
                "source_key": {"type": "string", "minLength": 1},
                "exact_excerpt": {"type": "string", "minLength": 1}
              }
            }
          },
          "aliases": {"type": "array", "items": {"type": "string"}},
          "answer_types": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "verification_plan": {
            "description": "A plan for checking answers to the canonical statement; it must not narrow or redefine that statement.",
            "type": "string",
            "minLength": 1
          },
          "rationale": {"type": "string"}
        }
      }
    }
  }
}
