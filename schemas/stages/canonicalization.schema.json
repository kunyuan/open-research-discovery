{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic canonicalization output",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusters"],
  "properties": {
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_title",
          "canonical_statement",
          "domain",
          "source_keys",
          "aliases",
          "rationale"
        ],
        "properties": {
          "canonical_title": {"type": "string", "minLength": 1},
          "canonical_statement": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "source_keys": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "aliases": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string"}
        }
      }
    }
  }
}
