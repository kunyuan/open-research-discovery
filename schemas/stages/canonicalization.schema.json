{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic canonicalization output",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusters"],
  "properties": {
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_title",
          "canonical_statement",
          "domain",
          "source_keys",
          "source_support",
          "aliases",
          "rationale"
        ],
        "properties": {
          "canonical_title": {"type": "string", "minLength": 1},
          "canonical_statement": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "source_keys": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "source_support": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_key",
                "exact_excerpt",
                "formal_proof_requested"
              ],
              "properties": {
                "source_key": {"type": "string", "minLength": 1},
                "exact_excerpt": {"type": "string", "minLength": 1},
                "formal_proof_requested": {"type": "boolean"}
              }
            }
          },
          "aliases": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string"}
        }
      }
    }
  }
}
