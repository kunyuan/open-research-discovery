{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topic Discovery Agent output",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain_id", "search_summary", "papers", "problem_leads"],
  "properties": {
    "domain_id": {"type": "string"},
    "search_summary": {"type": "string"},
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_id",
          "doi",
          "title",
          "context_summary",
          "source_intent",
          "evidence"
        ],
        "properties": {
          "paper_id": {"type": "string"},
          "doi": {"type": "string"},
          "title": {"type": "string"},
          "context_summary": {"type": "string", "minLength": 40},
          "source_intent": {"type": "string", "minLength": 20},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence"}
          }
        }
      }
    },
    "problem_leads": {
      "description": "Context-grounded possible research problems obtained from topic search. These are leads, not assertions that the source explicitly declared an open problem.",
      "type": "array",
      "items": {"$ref": "#/$defs/problem_lead"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "identifier", "url", "content_level", "supports"],
      "properties": {
        "source": {"enum": ["lkm", "web", "paper", "book", "dataset", "user_reference"]},
        "identifier": {"type": "string"},
        "url": {"type": "string"},
        "content_level": {
          "enum": [
            "metadata",
            "abstract",
            "compressed_claim",
            "reasoning_chain",
            "partial_full_text",
            "full_text"
          ]
        },
        "supports": {"type": "string"}
      }
    },
    "problem_lead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lead_id",
        "proposed_question",
        "answer_types",
        "source",
        "exact_excerpt",
        "surrounding_context",
        "source_intent",
        "derivation_rationale",
        "evidence"
      ],
      "properties": {
        "lead_id": {"type": "string", "minLength": 1},
        "proposed_question": {"type": "string", "minLength": 1},
        "answer_types": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "identifier", "url", "locator", "date"],
          "properties": {
            "kind": {"enum": ["lkm", "web", "paper", "book", "dataset", "user_reference"]},
            "title": {"type": "string", "minLength": 1},
            "identifier": {"type": "string"},
            "url": {"type": "string"},
            "locator": {"type": "string"},
            "date": {"type": "string"}
          }
        },
        "exact_excerpt": {"type": "string", "minLength": 1},
        "surrounding_context": {"type": "string", "minLength": 1},
        "source_intent": {"type": "string", "minLength": 1},
        "derivation_rationale": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
