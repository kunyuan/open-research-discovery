{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovery Agent output",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain_id", "papers"],
  "properties": {
    "domain_id": {"type": "string"},
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_id", "doi", "title", "evidence"],
        "properties": {
          "paper_id": {"type": "string"},
          "doi": {"type": "string"},
          "title": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {"$ref": "#/$defs/evidence"}
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "identifier", "url", "content_level", "supports"],
      "properties": {
        "source": {"enum": ["lkm", "web"]},
        "identifier": {"type": "string"},
        "url": {"type": "string"},
        "content_level": {
          "enum": [
            "metadata",
            "abstract",
            "compressed_claim",
            "reasoning_chain",
            "partial_full_text",
            "full_text"
          ]
        },
        "supports": {"type": "string"}
      }
    }
  }
}
