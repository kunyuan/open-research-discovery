{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem Contract content produced or rewritten by an Agent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent_problem_id",
    "subproblem_ids",
    "title",
    "abstract",
    "background",
    "references",
    "previous_progress",
    "problem_statement",
    "scientific_significance",
    "solution_difficulty",
    "verification_contracts",
    "verification_difficulty_score",
    "verification_difficulty_rationale"
  ],
  "properties": {
    "parent_problem_id": {"type": "string"},
    "subproblem_ids": {"type": "array", "items": {"type": "string"}},
    "title": {"type": "string", "minLength": 1},
    "abstract": {"type": "string", "minLength": 1},
    "background": {"type": "string", "minLength": 1},
    "references": {"type": "array", "items": {"type": "string"}},
    "previous_progress": {"type": "array", "items": {"type": "string"}},
    "problem_statement": {"type": "string", "minLength": 1},
    "scientific_significance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "level", "description"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "level": {"enum": ["high", "medium", "low"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "solution_difficulty": {"type": "array", "items": {"type": "string"}},
    "verification_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["answer_type", "contract", "ci_contract"],
        "properties": {
          "answer_type": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1},
          "ci_contract": {"type": "string"}
        }
      }
    },
    "verification_difficulty_score": {"type": "integer", "minimum": 0, "maximum": 10},
    "verification_difficulty_rationale": {"type": "string", "minLength": 1}
  }
}
