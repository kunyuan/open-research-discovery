{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topic Research Agent output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "problem",
    "report_markdown"
  ],
  "properties": {
    "candidate_id": {"type": "string"},
    "problem": {
      "description": "Source-audited material used to produce the public Problem Contract. Literature-status evidence remains operational metadata; significance and verification already use the public contract shapes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "question",
        "resolution_audit",
        "importance",
        "scientific_significance",
        "solution_difficulty",
        "verification_contract",
        "verification_difficulty"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "question": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_statement",
            "definitions",
            "scope",
            "aliases",
            "named_problem",
            "formulation_alignment",
            "authoritative_formulation"
          ],
          "properties": {
            "canonical_statement": {"type": "string", "minLength": 1},
            "definitions": {"type": "array", "items": {"type": "string"}},
            "scope": {"type": "string"},
            "aliases": {"type": "array", "items": {"type": "string"}},
            "named_problem": {"type": "boolean"},
            "formulation_alignment": {
              "enum": ["exact", "equivalent", "derived", "not_applicable"]
            },
            "authoritative_formulation": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["citation", "url", "exact_excerpt", "evidence_identifier"],
              "properties": {
                "citation": {"type": "string", "minLength": 1},
                "url": {"type": "string"},
                "exact_excerpt": {"type": "string", "minLength": 1},
                "evidence_identifier": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "resolution_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "coverage",
            "conclusion",
            "checked_through",
            "surviving_open_core",
            "evidence",
            "progress_assessment"
          ],
          "properties": {
            "status": {
              "enum": ["still_open", "partially_resolved", "resolved", "refuted", "uncertain"]
            },
            "coverage": {"enum": ["lkm_only", "systematic_literature"]},
            "conclusion": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "confidence"],
              "properties": {
                "label": {
                  "enum": ["confirmed_open", "likely_open", "resolved", "refuted", "needs_reformulation"]
                },
                "confidence": {"enum": ["high", "medium", "low"]}
              }
            },
            "checked_through": {"type": "string", "minLength": 1},
            "surviving_open_core": {"type": "string"},
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "title", "identifier", "url", "date", "content_level", "relation", "supports", "direct_support"],
                "properties": {
                  "source": {"enum": ["lkm", "web"]},
                  "title": {"type": "string"},
                  "identifier": {"type": "string"},
                  "url": {"type": "string"},
                  "date": {"type": "string"},
                  "content_level": {"enum": ["metadata", "abstract", "compressed_claim", "reasoning_chain", "partial_full_text", "full_text"]},
                  "relation": {"enum": ["closure", "refutation", "special_case", "improved_bound", "reformulation", "continuing_open", "adjacent_only"]},
                  "supports": {"type": "string"},
                  "direct_support": {"type": "boolean"}
                }
              }
            },
            "progress_assessment": {
              "type": "object",
              "additionalProperties": false,
              "required": ["major_progress_found", "effect"],
              "properties": {
                "major_progress_found": {"type": "boolean"},
                "effect": {
                  "enum": ["none", "narrows", "resolves", "refutes", "reframes", "uncertain"]
                }
              }
            }
          }
        },
        "importance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["motivation", "consequences_of_progress", "current_best_result"],
          "properties": {
            "motivation": {"type": "string"},
            "consequences_of_progress": {"type": "string"},
            "current_best_result": {"type": "string"}
          }
        },
        "scientific_significance": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "description"],
            "properties": {
              "level": {"enum": ["high", "medium", "low"]},
              "description": {"type": "string", "minLength": 1}
            }
          }
        },
        "solution_difficulty": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "verification_contract": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contract", "ci_contract"],
            "properties": {
              "contract": {"type": "string", "minLength": 1},
              "ci_contract": {"type": ["string", "null"]}
            }
          }
        },
        "verification_difficulty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "rationale"],
          "properties": {
            "score": {"type": "integer", "minimum": 0, "maximum": 10},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "report_markdown": {"type": "string", "minLength": 1}
  }
}
