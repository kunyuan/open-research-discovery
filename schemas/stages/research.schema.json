{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topic Research Agent output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "problem",
    "report_markdown",
    "decomposition_parent_coverage",
    "proposed_subproblems"
  ],
  "properties": {
    "candidate_id": {"type": "string"},
    "problem": {
      "description": "Problem draft whose nested sections mirror problem.schema.json. Pipeline-owned fields (id, status, schema_version, domain, topic_id, repository, source_open_questions, sources, question.lineage, resolution_audit.checked_through normalization, progress_assessment decision/reassessed flag, research_triage priorities/route) are derived or injected by the pipeline and must not appear here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "question",
        "resolution_audit",
        "importance",
        "research_triage",
        "discovery_contract",
        "solution_review_contract",
        "ci_contract"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "question": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_statement",
            "definitions",
            "scope",
            "aliases",
            "named_problem",
            "formulation_alignment",
            "authoritative_formulation"
          ],
          "properties": {
            "canonical_statement": {
              "description": "Audited source-faithful statement. Famous problems align with an authoritative literature formulation; any restricted variant is labeled as derived.",
              "type": "string",
              "minLength": 1
            },
            "definitions": {
              "description": "Ordered prose blocks explaining the scientific setting, specialist terms, prior result or limitation, and the unresolved target.",
              "type": "array",
              "items": {"type": "string"}
            },
            "scope": {
              "description": "Intrinsic source assumptions or an evidence-supported surviving core only; never a restriction introduced for verification convenience.",
              "type": "string"
            },
            "aliases": {"type": "array", "items": {"type": "string"}},
            "named_problem": {
              "description": "Pipeline-fixed identity field: copy the candidate's value verbatim.",
              "type": "boolean"
            },
            "formulation_alignment": {
              "enum": ["exact", "equivalent", "derived", "not_applicable"]
            },
            "authoritative_formulation": {
              "description": "Audited primary or standard formulation for a named problem, linked to direct research evidence; null otherwise.",
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["citation", "url", "exact_excerpt", "evidence_identifier"],
              "properties": {
                "citation": {"type": "string", "minLength": 1},
                "url": {"type": "string"},
                "exact_excerpt": {"type": "string", "minLength": 1},
                "evidence_identifier": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "resolution_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "conclusion",
            "checked_through",
            "surviving_open_core",
            "evidence",
            "progress_assessment"
          ],
          "properties": {
            "status": {
              "enum": ["still_open", "partially_resolved", "resolved", "refuted", "uncertain"]
            },
            "conclusion": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "confidence"],
              "properties": {
                "label": {
                  "enum": ["confirmed_open", "likely_open", "resolved", "refuted", "needs_reformulation"]
                },
                "confidence": {"enum": ["high", "medium", "low"]}
              }
            },
            "checked_through": {"type": "string", "minLength": 1},
            "surviving_open_core": {"type": "string"},
            "evidence": {
              "description": "Inspected later-literature records. A still-open or partially-resolved status with a confirmed_open or likely_open conclusion additionally requires at least one direct_support, non-metadata, traceable item; that conditional rule is enforced by pipeline validation, not by this schema.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "title", "identifier", "url", "date", "content_level", "relation", "supports", "direct_support"],
                "properties": {
                  "source": {"enum": ["lkm", "web"]},
                  "title": {"type": "string"},
                  "identifier": {"type": "string"},
                  "url": {"type": "string"},
                  "date": {"type": "string"},
                  "content_level": {"enum": ["metadata", "abstract", "compressed_claim", "reasoning_chain", "partial_full_text", "full_text"]},
                  "relation": {"enum": ["closure", "refutation", "special_case", "improved_bound", "reformulation", "continuing_open", "adjacent_only"]},
                  "supports": {"type": "string"},
                  "direct_support": {"type": "boolean"}
                }
              }
            },
            "progress_assessment": {
              "description": "The pipeline derives decision, the reassessment flags, and derived_problem_ids mechanically; the agent reports only whether major later progress exists and its effect.",
              "type": "object",
              "additionalProperties": false,
              "required": ["major_progress_found", "effect"],
              "properties": {
                "major_progress_found": {"type": "boolean"},
                "effect": {
                  "enum": ["none", "narrows", "resolves", "refutes", "reframes", "uncertain"]
                }
              }
            }
          }
        },
        "importance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["motivation", "consequences_of_progress", "current_best_result"],
          "properties": {
            "motivation": {"type": "string"},
            "consequences_of_progress": {"type": "string"},
            "current_best_result": {"type": "string"}
          }
        },
        "research_triage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "importance_level",
            "scientific_significance_score",
            "scientific_significance_rationale"
          ],
          "properties": {
            "importance_level": {"enum": ["high", "medium", "low", "unassessed"]},
            "scientific_significance_score": {"type": "integer", "minimum": 0, "maximum": 10},
            "scientific_significance_rationale": {"type": "string", "minLength": 1}
          }
        },
        "discovery_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_result", "answer_types"],
          "properties": {
            "expected_result": {"type": "string", "minLength": 1},
            "answer_types": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "solution_review_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verification_difficulty",
            "rationale",
            "verification_clarity",
            "verification_standard",
            "checklist",
            "estimated_review_time",
            "acceptance_boundary"
          ],
          "properties": {
            "verification_difficulty": {
              "description": "Residual independent-review burden scored from 0 to 10; descriptive only, not a publication threshold.",
              "type": "integer", "minimum": 0, "maximum": 10
            },
            "rationale": {"type": "string", "minLength": 1},
            "verification_clarity": {
              "description": "clear publishes the candidate as usual and requires empty proposed_subproblems with not_applicable coverage. needs_decomposition or unverifiable requires at least one proposed subproblem and complete or partial coverage; those subproblems enter the persistent topic queue so a later campaign can pose them. A research-stage candidate that remains too general to verify is never dropped: it must be decomposed into queued subproblems. These conditional rules are enforced by pipeline validation, not by this schema.",
              "enum": ["clear", "needs_decomposition", "unverifiable"]
            },
            "verification_standard": {
              "description": "Checks whether a submission answers the canonical statement without narrowing or redefining it.",
              "type": "string",
              "minLength": 1
            },
            "checklist": {
              "description": "Reviewer checklist prose; rendered into the problem README.",
              "type": "string",
              "minLength": 1
            },
            "estimated_review_time": {"type": "string", "minLength": 1},
            "acceptance_boundary": {"type": "string", "minLength": 1}
          }
        },
        "ci_contract": {
          "description": "Set status; when no substantive checker exists, use solution-reviewer-only and set every other field to null so the pipeline fills placeholders. When a real checker exists, fill every field concretely.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "workflow",
            "driver",
            "pseudocode",
            "runner",
            "estimated_runtime",
            "timeout_minutes"
          ],
          "properties": {
            "status": {
              "enum": ["implemented", "partial", "pseudocode", "solution-reviewer-only", "blocked"]
            },
            "workflow": {"type": ["string", "null"], "minLength": 1},
            "driver": {"type": ["string", "null"], "minLength": 1},
            "pseudocode": {"type": ["string", "null"], "minLength": 1},
            "runner": {"type": ["string", "null"], "minLength": 1},
            "estimated_runtime": {"type": ["string", "null"], "minLength": 1},
            "timeout_minutes": {"type": ["integer", "null"], "minimum": 0, "maximum": 1440}
          }
        }
      }
    },
    "report_markdown": {
      "description": "Free-form English audit narrative: the literature lineage and how later work treats this problem (what earlier schemas called literature_treatment and status_rationale), the importance argument, and an explicit statement of search coverage and remaining uncertainty.",
      "type": "string",
      "minLength": 1
    },
    "decomposition_parent_coverage": {
      "description": "complete only when the proposed source-supported children collectively cover the parent; partial retains the parent; not_applicable when no subproblems are proposed (required when no subproblems are proposed; complete or partial required whenever subproblems are proposed — enforced by pipeline validation).",
      "enum": ["complete", "partial", "not_applicable"]
    },
    "proposed_subproblems": {
      "description": "Required (at least one) when verification_clarity is needs_decomposition or unverifiable; must be empty when verification_clarity is clear. Every proposed subproblem enters the persistent topic queue (topic-queue.jsonl) and is replayed as a derived-subproblem source record in a later campaign instead of being discarded. This conditional rule is enforced by pipeline validation, not by this schema.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "scope", "answer_types", "verification_standard", "rationale", "relation_to_parent", "source_support"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "answer_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "verification_standard": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "relation_to_parent": {"enum": ["component", "restricted_derived"]},
          "source_support": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_key", "exact_excerpt"],
              "properties": {
                "source_key": {"type": "string", "minLength": 1},
                "exact_excerpt": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
