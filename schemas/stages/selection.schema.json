{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy Selection Agent output",
  "description": "Compatibility only for resuming pre-v19 runs. New campaigns select questions in Discovery and never invoke this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_title", "canonical_statement", "domain", "source_keys", "importance_level", "assessment"],
        "properties": {
          "canonical_title": {"type": "string", "minLength": 1},
          "canonical_statement": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "source_keys": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "importance_level": {"enum": ["high", "medium", "low", "unassessed"]},
          "assessment": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
