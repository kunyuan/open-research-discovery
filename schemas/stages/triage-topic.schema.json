{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topic candidate triage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "importance_level",
    "importance_rationale",
    "expected_result",
    "answer_types",
    "verification_difficulty",
    "verification_difficulty_rationale",
    "verification_standard"
  ],
  "properties": {
    "candidate_id": {"type": "string"},
    "importance_level": {"enum": ["high", "medium", "low"]},
    "importance_rationale": {"type": "string", "minLength": 1},
    "expected_result": {"type": "string", "minLength": 1},
    "answer_types": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "verification_difficulty": {"type": "integer", "minimum": 0, "maximum": 10},
    "verification_difficulty_rationale": {"type": "string", "minLength": 1},
    "verification_standard": {"type": "string", "minLength": 1}
  }
}
