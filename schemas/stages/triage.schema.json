{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triage Agent output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "gate",
    "importance_level",
    "importance_rationale",
    "consequences_of_progress",
    "solution_route",
    "route_scientific_effect",
    "route_sufficiency",
    "route_scope_limitations",
    "expected_result",
    "solution_review_scope",
    "solution_review_protocol",
    "ci_feasibility",
    "ci_pseudocode",
    "estimated_solution_review_time",
    "estimated_ci_runtime",
    "ci_timeout_minutes",
    "rationale"
  ],
  "properties": {
    "candidate_id": {"type": "string"},
    "gate": {"enum": ["pass", "low_priority"]},
    "importance_level": {"enum": ["high", "medium", "low", "unassessed"]},
    "importance_rationale": {"type": "string"},
    "consequences_of_progress": {"type": "string"},
    "solution_route": {"type": "string", "minLength": 1},
    "route_scientific_effect": {
      "enum": [
        "resolves-core",
        "refutes-core",
        "proves-core",
        "sharpens-bound",
        "constructs-requested-object",
        "meaningful-partial-progress",
        "benchmark-only",
        "uncertain"
      ]
    },
    "route_sufficiency": {"type": "boolean"},
    "route_scope_limitations": {"type": "string"},
    "expected_result": {"type": "string", "minLength": 1},
    "solution_review_scope": {
      "description": "result-only means an independent LLM or checker can basically decide correctness from the submitted result, frozen problem specification, and declared reference data, without consulting the solver's search or reasoning process. Code or formal proof is part of the result only when that is the answer format requested by the original problem.",
      "enum": [
        "result-only",
        "result-and-derivation",
        "expert-intensive",
        "unclassified"
      ]
    },
    "solution_review_protocol": {"type": "string", "minLength": 1},
    "ci_feasibility": {
      "enum": ["implemented", "partial", "pseudocode", "solution-reviewer-only", "blocked"]
    },
    "ci_pseudocode": {"type": "array", "items": {"type": "string"}},
    "estimated_solution_review_time": {"type": "string"},
    "estimated_ci_runtime": {"type": "string"},
    "ci_timeout_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
    "rationale": {"type": "string"}
  }
}
