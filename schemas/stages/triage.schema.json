{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triage Agent output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "gate",
    "importance_level",
    "importance_rationale",
    "consequences_of_progress",
    "solution_route",
    "route_scientific_effect",
    "route_sufficiency",
    "route_scope_limitations",
    "acceptance_obligations",
    "uses_proof_assistant",
    "expected_artifact",
    "artifact_type",
    "verification_mode",
    "verification_ease",
    "review_scope",
    "verification_protocol",
    "ci_feasibility",
    "ci_pseudocode",
    "estimated_review_time",
    "estimated_ci_runtime",
    "ci_timeout_minutes",
    "rationale"
  ],
  "properties": {
    "candidate_id": {"type": "string"},
    "gate": {"enum": ["pass", "low_priority"]},
    "importance_level": {"enum": ["high", "medium", "low", "unassessed"]},
    "importance_rationale": {"type": "string"},
    "consequences_of_progress": {"type": "string"},
    "solution_route": {"type": "string", "minLength": 1},
    "route_scientific_effect": {
      "enum": [
        "resolves-core",
        "refutes-core",
        "proves-core",
        "sharpens-bound",
        "constructs-requested-object",
        "meaningful-partial-progress",
        "benchmark-only",
        "uncertain"
      ]
    },
    "route_sufficiency": {"type": "boolean"},
    "route_scope_limitations": {"type": "string"},
    "acceptance_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_key",
          "exact_excerpt",
          "kind",
          "description",
          "required"
        ],
        "properties": {
          "source_key": {"type": "string", "minLength": 1},
          "exact_excerpt": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "direct-artifact",
              "source-requested-formal-proof",
              "derivation",
              "expert-judgment"
            ]
          },
          "description": {"type": "string", "minLength": 1},
          "required": {"const": true}
        }
      }
    },
    "uses_proof_assistant": {"type": "boolean"},
    "expected_artifact": {"type": "string"},
    "artifact_type": {
      "enum": [
        "counterexample",
        "construction",
        "algorithm",
        "certificate",
        "formal-proof",
        "theorem-boundary",
        "dataset",
        "experimental-result",
        "simulation-result",
        "model",
        "protocol",
        "other"
      ]
    },
    "verification_mode": {
      "enum": [
        "machine-checkable",
        "llm-reviewable",
        "hybrid",
        "expert-review",
        "unclassified"
      ]
    },
    "verification_ease": {"enum": ["easy", "moderate", "hard", "unclassified"]},
    "review_scope": {
      "description": "result-only means the frozen problem, source-grounded final deliverable, trusted verifiers, and frozen reference data suffice; hiding the solver's search and reasoning process and every undeclared auxiliary explanation cannot change the verdict. Formal proof code counts only when the source explicitly requests formalization or a machine-checkable proof or certificate. Verification mode is independent.",
      "enum": [
        "result-only",
        "result-and-derivation",
        "expert-intensive",
        "unclassified"
      ]
    },
    "verification_protocol": {"type": "string"},
    "ci_feasibility": {
      "enum": ["implemented", "partial", "pseudocode", "reviewer-only", "blocked"]
    },
    "ci_pseudocode": {"type": "array", "items": {"type": "string"}},
    "estimated_review_time": {"type": "string"},
    "estimated_ci_runtime": {"type": "string"},
    "ci_timeout_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
    "rationale": {"type": "string"}
  }
}
