{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triage Agent output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "importance_level",
    "importance_rationale",
    "expected_result",
    "verification_difficulty",
    "verification_difficulty_rationale",
    "ci_status",
    "ci_pseudocode",
    "estimated_ci_runtime",
    "ci_timeout_minutes"
  ],
  "properties": {
    "candidate_id": {"type": "string"},
    "importance_level": {"enum": ["high", "medium", "low", "unassessed"]},
    "importance_rationale": {"type": "string"},
    "expected_result": {"type": "string", "minLength": 1},
    "verification_difficulty": {
      "description": "Independent verification difficulty from 0 to 10. Zero means review is basically limited to the final result and does not imply mechanical verification. Scores 1-9 represent increasing dependence on substantive derivation review; 10 means correctness rests essentially on holistic review of a natural-language proof or scientific argument.",
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "verification_difficulty_rationale": {"type": "string", "minLength": 1},
    "ci_status": {
      "enum": [
        "implemented",
        "partial",
        "pseudocode",
        "solution-reviewer-only",
        "blocked",
        "unassessed"
      ]
    },
    "ci_pseudocode": {"type": "array", "items": {"type": "string"}},
    "estimated_ci_runtime": {"type": "string"},
    "ci_timeout_minutes": {"type": "integer", "minimum": 0, "maximum": 1440}
  }
}
